# Copy to .env on the server and fill in real values. Never commit .env.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=change-me
SMTP_FROM="Document Hub <notifications@example.com>"
APP_BASE_URL=http://your-server:3005
VITE_APP_URL=http://your-server:3005
PORTAL_BASE_URL=http://your-server:3005
PORTAL_SSO_SECRET=change-me-long-random-string
